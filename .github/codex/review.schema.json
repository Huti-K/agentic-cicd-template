{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "needs_changes"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["severity", "path", "line", "description"],
        "properties": {
          "severity": { "type": "string", "enum": ["P1", "P2"] },
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
