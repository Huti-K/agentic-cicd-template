{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "findings"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "needs_changes"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "path",
          "line",
          "description"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P1",
              "P2"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      },
      "maxItems": 10
    }
  }
}
