{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "description", "acceptanceCriteria", "files", "documentation", "ready"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "description": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
    "files": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/reference" } },
    "documentation": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/reference" } },
    "ready": { "type": "boolean" }
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["path", "reason"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 260 }, "reason": { "type": "string", "minLength": 1, "maxLength": 600 } }
    }
  }
}
