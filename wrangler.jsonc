{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-agent-platform",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-11",
  "account_id": "be96904e165a27628b2b1cb1f9bce373",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "relay-platform",
    "database_id": "1f497c83-fbe4-4f1a-bf8f-493345a1cfe7",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "GITHUB_REPOSITORY": "Huti-K/agentic-cicd-template",
    "AGENT_REF": "main",
    "DEPLOYMENT_URL": "https://relay-agent-platform.oktami.workers.dev"
  }
}
