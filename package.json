{
  "name": "agentic-cicd-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "dev:platform": "npm run build && wrangler d1 migrations apply DB --local && wrangler dev",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/test.mjs",
    "test:browser": "playwright test",
    "tools:install": "node scripts/install-tools.mjs",
    "lint:workflows": ".cache/tools/actionlint -shellcheck=",
    "scan:secrets": ".cache/tools/gitleaks git --redact=100 --no-banner --log-opts=--all",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "wrangler": "4.149.0",
    "yaml": "2.9.1"
  }
}
